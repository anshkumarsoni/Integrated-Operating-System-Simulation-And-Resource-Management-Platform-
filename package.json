{
  "name": "os-simulation-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Integrated Operating System Simulation and Resource Management Platform",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "start": "npm --prefix frontend run dev",
    "server": "npm --prefix backend start",
    "server:dev": "npm --prefix backend run dev",
    "init:db": "npm --prefix backend run init:db",
